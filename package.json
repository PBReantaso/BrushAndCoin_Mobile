{
  "name": "brushandcoin-monorepo",
  "version": "1.0.0",
  "description": "Brush&Coin - Creative marketplace for artists and clients",
  "private": true,
  "workspaces": [
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "cd web && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "start:web": "cd web && npm run start",
    "dev:mobile": "cd mobile && flutter run",
    "build:mobile": "cd mobile && flutter build",
    "build:mobile:android": "cd mobile && flutter build apk",
    "build:mobile:ios": "cd mobile && flutter build ios",
    "build:all": "npm run build:web && npm run build:mobile",
    "test:web": "cd web && npm run test",
    "test:mobile": "cd mobile && flutter test",
    "lint:web": "cd web && npm run lint",
    "lint:mobile": "cd mobile && flutter analyze",
    "clean:web": "cd web && rm -rf .next node_modules",
    "clean:mobile": "cd mobile && flutter clean",
    "install:web": "cd web && npm install",
    "install:mobile": "cd mobile && flutter pub get",
    "install:all": "npm run install:web && npm run install:mobile",
    "type-check:shared": "cd shared && npx tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "art",
    "commission",
    "marketplace",
    "creative",
    "flutter",
    "nextjs",
    "typescript"
  ],
  "author": "Brush&Coin Team",
  "license": "MIT"
}
